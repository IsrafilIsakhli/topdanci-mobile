{
  "name": "topdanbazar-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --localhost --port 8083",
    "phone": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --go --lan --port 8084",
    "phone:tunnel": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --go --tunnel --port 8084",
    "android": "expo run:android",
    "android:x86": "cd android && gradlew.bat app:installDebug -PreactNativeArchitectures=x86_64",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "emu:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode status",
    "emu:turbo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode turbo",
    "emu:lowres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode turbo -LowRes",
    "emu:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode reset",
    "emu:config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode config",
    "emu:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-emulator-perf.ps1 -Mode launch",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npx expo export --platform android"
  },
  "private": true
}
