# Lokal inkişafda nümunə kataloq avtomatik açılır. Canlı kataloq üçün false yazın.
EXPO_PUBLIC_DEMO_CATALOG=true
# Fiziki telefon üçün localhost əvəzinə kompüterin LAN IP ünvanını yazın.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_CDN_BASE_URL=
# Paylaşım linklərinin işlədiyi saytın HTTPS ünvanı.
EXPO_PUBLIC_WEB_BASE_URL=https://topdanci-az.vercel.app

# Push üçün EAS layihəsinin ID-si; xidmət hazır olmayınca boş saxlayın.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android Firebase ayar faylının lokal yolu (git-ə daxil edilmir).
GOOGLE_SERVICES_FILE=
